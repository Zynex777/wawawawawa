generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique
  criadoEm DateTime @default(now()) @map("criado_em")
  canais   Canal[]
  lojas    Loja[]
  videos   Video[]

  @@map("usuario")
}

model Canal {
  id             String     @id @default(uuid()) @db.Uuid
  usuario        Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId      String     @map("usuario_id") @db.Uuid
  rede           String
  suporte        String
  accessToken    String?    @map("access_token")
  refreshToken   String?    @map("refresh_token")
  expiraEm       DateTime?  @map("expira_em")
  contaConectada String?    @map("conta_conectada")
  contaId        String?    @map("conta_id")
  conectado      Boolean    @default(false)
  postagens      Postagem[]

  @@map("canal")
}

model Loja {
  id           String  @id @default(uuid()) @db.Uuid
  usuario      Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId    String  @map("usuario_id") @db.Uuid
  nome         String
  padrao       Boolean @default(false)
  templateLink String? @map("template_link")
  videos       Video[]

  @@map("loja")
}

model Video {
  id           String     @id @default(uuid()) @db.Uuid
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  usuarioId    String     @map("usuario_id") @db.Uuid
  loja         Loja       @relation(fields: [lojaId], references: [id])
  lojaId       String     @map("loja_id") @db.Uuid
  produtoNome  String     @map("produto_nome")
  linkAfiliado String     @map("link_afiliado")
  legenda      String?
  urlArquivo   String?    @map("url_arquivo")
  origem       String
  status       String     @default("rascunho")
  criadoEm     DateTime   @default(now()) @map("criado_em")
  postagens    Postagem[]

  @@map("video")
}

model Postagem {
  id           String    @id @default(uuid()) @db.Uuid
  video        Video     @relation(fields: [videoId], references: [id])
  videoId      String    @map("video_id") @db.Uuid
  canal        Canal     @relation(fields: [canalId], references: [id])
  canalId      String    @map("canal_id") @db.Uuid
  status       String
  dataAgendada DateTime  @default(now()) @map("data_agendada")
  dataPostada  DateTime? @map("data_postada")
  erro         String?

  @@map("postagem")
}
